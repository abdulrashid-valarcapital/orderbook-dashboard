PORT=8765

# Local folder containing instrument_dict.dat, series_meta_*m.dat, bars_*m.dat.
# PRICE_STORE_ROOT=/absolute/path/to/pricestore

# Local zip source, useful on your Mac.
# PRICE_STORE_ZIP=/absolute/path/to/pricestore_snapshot_full.zip

# Render/cloud source. Use either the Drive file id or a direct downloadable URL.
# PRICE_STORE_ZIP_ID=your_google_drive_file_id
# PRICE_STORE_ZIP_URL=https://drive.google.com/uc?export=download&id=your_google_drive_file_id

# Render free filesystem is temporary. /tmp is the safest cache root there.
PRICE_STORE_CACHE_ROOT=/tmp/priceStoreCache

# Range-readable all-timeframes price-store ZIP.
PRICE_STORE_ALL_TIMEFRAMES_ZIP_ID=1v56gV-Lf6cR09Q0hgC3u-yt0JTMSRktC
PRICE_STORE_ALL_TIMEFRAMES=5,15,30,60,375,1875

# Direct 375/1D candle CSV folder. Files are expected as SYMBOL.csv.
PRICE_STORE_375_DRIVE_FOLDER_ID=149bAVH0lOopQL8CHyiDcoTogzvFdPPub
